VITE_API_URL=http://localhost:4000
VITE_WA_API_URL=http://localhost:3000
VITE_WA_SVC_URL=http://localhost:3001
VITE_WA_API_KEY=your-api-key-here

# ── Firebase Web Push (Cloud Messaging) ────────────────────────────────────
# From Firebase Console → Project Settings → General → "Your apps" → Web app.
# All four are required for the "Enable notifications" button to appear —
# without them the admin portal falls back to in-app Socket.IO alerts only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Console → Cloud Messaging tab → "Web Push certificates" → generate one.
VITE_FIREBASE_VAPID_KEY=

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  firstName    String
  lastName     String
  organization String   @default("")
  role         String   @default("user")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurants      Restaurant[]
  whatsappSessions WhatsAppSession[]
  aiCredentials    AICredentials?
  voiceCredit      VoiceCredit?
  prompts          Prompt[]
  phoneNumbers     PhoneNumber[]
  knowledgeBases   KnowledgeBase[]
}

model Restaurant {
  id                     String   @id @default(uuid())
  name                   String
  description            String   @default("")
  cuisine                String
  rating                 Float    @default(0)
  reviewCount            Int      @default(0)
  deliveryFee            Float    @default(0)
  deliveryTimeMinutesMin Int      @default(20)
  deliveryTimeMinutesMax Int      @default(45)
  currencyCode           String   @default("KES")
  currencySymbol         String   @default("KSh")
  address                String
  locationLat            Float?
  locationLng            Float?
  imageUrl               String   @default("")
  phone                  String   @default("")
  hours                  String   @default("Mon-Sun 08:00-22:00")
  minOrder               Float    @default(0)
  features               String[]
  isPromoted             Boolean  @default(false)
  discount               String   @default("")
  isOpen                 Boolean  @default(true)
  ownerId                String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  owner            User?              @relation(fields: [ownerId], references: [id])
  menuItems        MenuItem[]
  orders           Order[]
  aiConfig         RestaurantAIConfig?
  knowledgeBases   KnowledgeBase[]
  whatsappSessions WhatsAppSession[]
  phoneNumbers     PhoneNumber[]
  interactionLogs  AIInteractionLog[]
}

model MenuItem {
  id              String   @id @default(uuid())
  restaurantId    String
  name            String
  description     String   @default("")
  price           Float
  imageUrl        String   @default("")
  category        String
  isAvailable     Boolean  @default(true)
  isVegetarian    Boolean  @default(false)
  isFeatured      Boolean  @default(false)
  rating          Float    @default(0)
  prepTimeMinutes Int      @default(15)
  allergens       String[]
  calories        Int?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Order {
  id                  String   @id @default(uuid())
  restaurantId        String
  restaurantLocLat    Float?
  restaurantLocLng    Float?
  restaurantLocAddr   String?
  items               Json
  subtotal            Float
  deliveryFee         Float    @default(0)
  tax                 Float    @default(0)
  total               Float
  status              String   @default("pending")
  customerName        String
  customerPhone       String?
  customerId          String?
  deliveryAddress     String
  deliveryLocLat      Float?
  deliveryLocLng      Float?
  driverId            String?
  etaMinutes          Int?
  specialInstructions String?
  paymentMethod       String   @default("mpesa")
  paymentStatus       String   @default("pending")
  statusHistory       Json     @default("[]")
  source              String   @default("web")
  cancellationReason  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  rider      Rider?     @relation(fields: [driverId], references: [id])
  payments   Payment[]
}

model Rider {
  id          String   @id @default(uuid())
  name        String
  phone       String
  email       String?
  status      String   @default("offline")
  currentLat  Float?
  currentLng  Float?
  vehicleType String   @default("motorcycle")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]
}

model Payment {
  id        String   @id @default(uuid())
  orderId   String?
  userId    String?
  amount    Float
  method    String
  status    String   @default("pending")
  reference String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order? @relation(fields: [orderId], references: [id])
}

model RestaurantAIConfig {
  id                     String   @id @default(uuid())
  restaurantId           String   @unique
  upsellRules            Json     @default("[]")
  voiceEnabled           Boolean  @default(false)
  voicePersona           String   @default("Friendly AI assistant")
  voiceLanguages         String[]
  voiceGreeting          String   @default("Hello! Welcome. How can I help you today?")
  voiceFallbackMessage   String   @default("I'm sorry, let me connect you to a human agent.")
  waEnabled              Boolean  @default(false)
  waPersona              String   @default("Helpful WhatsApp assistant")
  waGreeting             String   @default("Hi! Welcome. How can I assist you?")
  waOrderConfirmationMsg String   @default("Your order #{orderId} has been confirmed! Estimated delivery: {eta} mins.")
  waDeliveryUpdateMsg    String   @default("Update on order #{orderId}: {status}. {message}")
  autoConfirmOrders      Boolean  @default(false)
  maxOrdersPerHour       Int?
  orderClosingTime       String?
  ragEnabled             Boolean  @default(true)
  ragTopK                Int      @default(5)
  ragScoreThreshold      Float    @default(0.72)
  mpesaEnabled           Boolean  @default(false)
  mpesaPaybill           String?
  mpesaTillNumber        String?
  updatedBy              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model KnowledgeBase {
  id           String    @id @default(uuid())
  restaurantId String
  title        String
  docType      String    @default("general")
  status       String    @default("processing")
  rawContent   String
  chunks       Json      @default("[]")
  fileUrl      String?
  fileName     String?
  mimeType     String?
  wordCount    Int       @default(0)
  errorMessage String?
  vectorisedAt DateTime?
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  creator    User       @relation(fields: [createdBy], references: [id])
}

model AIInteractionLog {
  id              String   @id @default(uuid())
  restaurantId    String?
  userId          String?
  sessionId       String?
  channel         String   @default("whatsapp")
  customerPhone   String?
  userMessage     String
  aiResponse      String
  intent          String?
  tokensUsed      Int      @default(0)
  latencyMs       Int      @default(0)
  retrievedChunks Json?
  orderPlaced     Boolean  @default(false)
  orderId         String?
  escalated       Boolean  @default(false)
  createdAt       DateTime @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
}

model WhatsAppSession {
  id           String    @id @default(uuid())
  userId       String
  sessionId    String    @unique
  name         String    @default("")
  phone        String?
  pushname     String?
  status       String    @default("initializing")
  promptId     String?
  restaurantId String?
  lastActiveAt DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
}

model WhatsAppMessage {
  id        String    @id @default(uuid())
  userId    String?
  sessionId String
  chatId    String
  from      String    @default("")
  to        String?
  body      String    @default("")
  direction String    @default("in")
  fromMe    Boolean   @default(false)
  isGroup   Boolean   @default(false)
  author    String?
  hasMedia  Boolean   @default(false)
  replyKind String?
  messageId String?
  timestamp DateTime  @default(now())
  metadata  Json?
}

model WhatsAppChatState {
  id        String   @id @default(uuid())
  sessionId String
  chatId    String
  aiPaused  Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([sessionId, chatId])
}

model PhoneNumber {
  id              String   @id @default(uuid())
  userId          String
  restaurantId    String?
  number          String
  phoneNumber     String?
  label           String   @default("")
  isActive        Boolean  @default(true)
  sipUri          String?
  promptId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
}

model AICredentials {
  id                 String   @id @default(uuid())
  userId             String   @unique
  openaiApiKey       String?
  twilioAccountSid   String?
  twilioAuthToken    String?
  twilioPhoneNumber  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Prompt {
  id        String   @id @default(uuid())
  userId    String
  name      String
  content   String
  status    String   @default("active")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model VoiceCredit {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model VoiceCall {
  id           String   @id @default(uuid())
  userId       String?
  phoneNumber  String?
  promptId     String?
  callSid      String?  @unique
  from         String   @default("")
  to           String   @default("")
  status       String   @default("ongoing")
  duration     Int      @default(0)
  recordingUrl String?
  createdAt    DateTime @default(now())
}

model Autopilot {
  id        String   @id @default(uuid())
  userId    String
  sessionId String?
  isEnabled Boolean  @default(false)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reservation {
  id            String   @id @default(uuid())
  restaurantId  String
  customerName  String
  customerPhone String?
  customerEmail String?
  date          DateTime
  partySize     Int
  status        String   @default("pending")
  notes         String?
  tableNumber   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OrderPayment {
  id        String   @id @default(uuid())
  orderId   String
  amount    Float
  method    String
  status    String
  reference String?
  createdAt DateTime @default(now())
}

model WhatsAppLead {
  id                String    @id @default(uuid())
  userId            String?
  sessionId         String?
  chatId            String
  name              String?
  phone             String?
  location          String?
  requirement       String?
  turns             Int       @default(0)
  restaurantId      String?
  source            String    @default("whatsapp")
  lastInteractionAt DateTime?
  createdAt         DateTime  @default(now())
}

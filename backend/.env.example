PORT=5000
MONGODB_URI=mongodb://localhost:27017/azizi-portal
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud
GCP_SERVICE_ACCOUNT_JSON={}
GCP_DRIVE_FOLDER_ID=your_drive_folder_id_here

# Twilio (for phone integration)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Admin credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_password_here

# M-Pesa Daraja API
MPESA_ENV=production
C2B_PAYBILL=4141855
C2B_CONSUMER_KEY=your_consumer_key
C2B_CONSUMER_SECRET=your_consumer_secret
C2B_PASSKEY=your_passkey
C2B_CALLBACK_URL=https://yourdomain.com/api/credits/mpesa/callback
C2B_SECURITY_CREDENTIAL=your_security_credential
C2B_REVERSAL_INITIATOR=your_reversal_initiator

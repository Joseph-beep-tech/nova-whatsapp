# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get this from: MongoDB Atlas → Cluster → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/novago?retryWrites=true&w=majority&appName=Cluster0

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── WhatsApp (baileys-api / wwebjs-api proxy) ─────────────────────────────────
# Base URL of the deployed WhatsApp session service (see baileys-api/), e.g.
# the Railway public domain of that service, or its Railway private domain
# (http://<service>.railway.internal:<port>) when both run in the same project.
WHATSAPP_API_URL=https://your-baileys-api.up.railway.app
# Must match the API_KEY env var configured on that service.
WHATSAPP_API_KEY=change_this_to_match_the_whatsapp_service

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# ── M-Pesa Daraja API ─────────────────────────────────────────────────────────
MPESA_ENV=sandbox
C2B_PAYBILL=174379
C2B_CONSUMER_KEY=your_consumer_key
C2B_CONSUMER_SECRET=your_consumer_secret
C2B_PASSKEY=your_passkey
C2B_CALLBACK_URL=https://yourdomain.com/api/payments/mpesa/callback
C2B_SECURITY_CREDENTIAL=your_security_credential
C2B_REVERSAL_INITIATOR=your_initiator

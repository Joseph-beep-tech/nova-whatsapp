PORT=3000
API_KEY=change_this_to_match_the_backend_service
SESSIONS_PATH=/app/sessions

# Where to forward inbound WhatsApp messages for persistence + AI reply.
# Use Railway's private network domain when both services share a project,
# e.g. http://nova-whatsapp.railway.internal:5000/api/whatsapp/webhook/inbound
BACKEND_WEBHOOK_URL=http://your-backend-service.railway.internal:5000/api/whatsapp/webhook/inbound
